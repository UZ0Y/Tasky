# Tasky Environment Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to version control
# 4. Add .env to .gitignore

# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Discord Bot Token
# Get this from: https://discord.com/developers/applications
# 1. Create/select an application
# 2. Go to "Bot" section
# 3. Click "Add Bot"
# 4. Copy the token
TOKEN=your_discord_bot_token_here

# Google Gemini API Key
# Get this from: https://aistudio.google.com/apikey
# 1. Sign in with Google account
# 2. Click "Create API Key"
# 3. Copy the key
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# Gemini Model to use
# Default: gemini-2.5-flash
# Options: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Flask Debug Mode (for web dashboard)
# Default: False
# Set to True for development only!
FLASK_DEBUG=False

# Database path (uncomment to customize)
# Default: ./data/tasks.db
# DB_PATH=./data/tasks.db

# Log level
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
